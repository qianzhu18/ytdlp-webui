#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
RUNTIME_ROOT="${MUKU_RUNTIME_ROOT:-${HOME}/.local/share/muku-video-downloade}"
VENV_DIR="${RUNTIME_ROOT}/venv"
BIN_DIR="${MUKU_BIN_DIR:-/opt/homebrew/bin}"

python3 -m venv "${VENV_DIR}"
"${VENV_DIR}/bin/python" -m pip install --upgrade pip
# Editable installs break when the repository is moved or renamed.
"${VENV_DIR}/bin/python" -m pip install --force-reinstall "${REPO_ROOT}"

mkdir -p "${BIN_DIR}"
for WRAPPER_NAME in muku video-downloade; do
  WRAPPER="${BIN_DIR}/${WRAPPER_NAME}"
  printf '#!/bin/sh\nexec "%s/bin/muku" "$@"\n' "${VENV_DIR}" > "${WRAPPER}"
  chmod +x "${WRAPPER}"
done

muku doctor --json >/dev/null
echo "Installed Muku CLI to ${BIN_DIR}/muku (alias ${BIN_DIR}/video-downloade)"
